{
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_YOUR_PRODUCTION_DB_CONNECTION_STRING"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_SECURE_64_CHARACTER_HEX_KEY",
    "Issuer": "HotWaterGas",
    "Audience": "HotWaterGasClient",
    "AccessTokenExpiryMinutes": 60
  },
  "Auth": {
    "RefreshTokenExpiryDays": 30,
    "RefreshCookieName": "refresh-token",
    "CookieSecurePolicySetting": "Always",
    "CookieSameSiteModeSetting": "None"
  },
  "MailerSend": {
    "ApiToken": "REPLACE_WITH_YOUR_MAILERSEND_API_TOKEN",
    "FromEmail": "no-reply@yourdomain.com",
    "FromName": "HotWaterGas"
  },
  "PayOS": {
    "ClientId": "REPLACE_WITH_YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "REPLACE_WITH_YOUR_PAYOS_API_KEY",
    "ChecksumKey": "REPLACE_WITH_YOUR_PAYOS_CHECKSUM_KEY"
  },
  "Cloudinary": {
    "CloudName": "REPLACE_WITH_YOUR_CLOUD_NAME",
    "ApiKey": "REPLACE_WITH_YOUR_API_KEY",
    "ApiSecret": "REPLACE_WITH_YOUR_API_SECRET",
    "MaxFileSizeBytes": 10485760
  },
  "PublicAssets": {
    "BaseUrl": "REPLACE_WITH_YOUR_CLOUDINARY_PUBLIC_URL"
  },
  "Frontend": {
    "BaseUrl": "https://your-frontend.vercel.app",
    "SuccessUrl": "https://your-frontend.vercel.app/checkout/payment-success",
    "CancelUrl": "https://your-frontend.vercel.app/checkout/payment-cancel"
  },
  "CORS": {
    "AllowedOrigins": [
      "https://your-frontend.vercel.app"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
