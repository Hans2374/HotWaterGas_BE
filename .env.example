# =============================================================================
# HotWaterGas Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env files with real credentials to version control!
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQL Server connection string
# For production: Use a managed database service (Azure SQL, Render Postgres, AWS RDS, etc.)
# ConnectionStrings__DefaultConnection=Server=localhost;Database=HotWaterGasDB;User Id=sa;Password=your_password;Encrypt=False;TrustServerCertificate=True
ConnectionStrings__DefaultConnection=Server=your-db-host.com;Database=HotWaterGasDB;User Id=your_db_user;Password=your_db_password;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# IMPORTANT: Generate a new secure key for production!
# Use: dotnet dev-certs https -t --export-path ./jwt-key.txt
# Or: openssl rand -hex 64
Jwt__Key=YOUR_SUPER_SECURE_JWT_SECRET_KEY_AT_LEAST_64_CHARACTERS_LONG_HERE
Jwt__Issuer=HotWaterGas
Jwt__Audience=HotWaterGasClient
Jwt__AccessTokenExpiryMinutes=15

# =============================================================================
# AUTHENTICATION - REFRESH TOKEN
# =============================================================================
Auth__RefreshTokenExpiryDays=30
Auth__RefreshCookieName=refresh-token
# CookieSecurityPolicy: Always (production), SameAsRequest (development with HTTPS)
Auth__CookieSecurePolicySetting=Always
# CookieSameSite: None (required for cross-origin), Strict, Lax
Auth__CookieSameSiteModeSetting=None

# =============================================================================
# EMAIL SERVICE - MailerSend
# =============================================================================
# Get your API token from: https://app.mailersend.com/api-tokens
MailerSend__ApiToken=mlsn.your_api_token_here
MailerSend__FromEmail=no-reply@yourdomain.com
MailerSend__FromName=HotWaterGas

# =============================================================================
# PAYMENT GATEWAY - PayOS (Vietnam)
# =============================================================================
# Register at: https://payos.vn/
PayOS__ClientId=your_payos_client_id
PayOS__ApiKey=your_payos_api_key
PayOS__ChecksumKey=your_payos_checksum_key

# =============================================================================
# IMAGE STORAGE - Cloudinary
# =============================================================================
# Sign up at: https://cloudinary.com/
Cloudinary__CloudName=your_cloud_name
Cloudinary__ApiKey=your_api_key
Cloudinary__ApiSecret=your_api_secret
# Maximum file size for uploads (default: 10MB = 10485760 bytes)
Cloudinary__MaxFileSizeBytes=10485760

# =============================================================================
# FRONTEND URLs (for payment redirects, CORS)
# =============================================================================
# Update these to your production frontend URL
Frontend__BaseUrl=https://your-frontend-url.vercel.app
Frontend__SuccessUrl=https://your-frontend-url.vercel.app/checkout/payment-success
Frontend__CancelUrl=https://your-frontend-url.vercel.app/checkout/payment-cancel

# =============================================================================
# CORS - Allowed Origins
# =============================================================================
# Add your production frontend domain here
CORS__AllowedOrigins__0=https://your-frontend-url.vercel.app
CORS__AllowedOrigins__1=http://localhost:5173
CORS__AllowedOrigins__2=http://localhost:3000

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Set to false in production for security
ASPNETCORE_ENVIRONMENT=Development
# Set to true in production to enforce HTTPS
ASPNETCORE_FORCE_HTTPS_REDIRECTION=false
# Enable Swagger in Development only
ASPNETCORE_ENABLE_SWAGGER=true

# =============================================================================
# LOGGING
# =============================================================================
# LogLevel options: Trace, Debug, Information, Warning, Error, Critical, None
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# =============================================================================
# OPTIONAL: EXTERNAL SERVICES
# =============================================================================
# Add any additional service credentials below
